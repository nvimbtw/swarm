#!/usr/bin/env python3
"""Deterministic daemon proxy fixture. Never calls an inference API."""
import json
import os
from pathlib import Path
import sys

root = Path(os.environ["SWARM_TEST_CODEX_ROOT"])
queued = {}


def send(value):
    print(json.dumps(value), flush=True)


def notify(method, params):
    send({"method": method, "params": params})


for line in sys.stdin:
    request = json.loads(line)
    method, params = request["method"], request.get("params", {})
    with (root / "calls.jsonl").open("a") as log:
        log.write(json.dumps(request) + "\n")
    if "id" not in request:
        continue
    thread = params.get("threadId")
    busy = (root / "busy").exists()
    result = {}
    if method == "thread/read":
        result = {"thread": {"id": thread, "cwd": str(root), "model": "test-model",
            "reasoningEffort": "medium", "status": {"type": "active" if busy else "idle"}}}
    elif method == "model/list":
        result = {"data": [{"model": "test-model", "displayName": "Test model",
            "supportedReasoningEfforts": [{"reasoningEffort": "medium"}, {"reasoningEffort": "high"}]}]}
    elif method == "thread/queue/list":
        result = {"data": []}
    elif method == "thread/turns/list":
        result = {"data": [{"id": "local-turn", "status": "inProgress"}] if busy else []}
    elif method == "thread/queue/add":
        queued[thread] = params["input"][0]["text"]
        result = {"queuedSubmission": {"id": "native-" + params["clientUserMessageId"]}}
    elif method == "thread/queue/start":
        turn_id = "turn-" + params["queuedSubmissionId"]
        if (root / "race").exists():
            send({"id": request["id"], "error": {"message": "reply unavailable after native queue acceptance", "code": -32603}})
            continue
        if (root / "busy-race").exists():
            (root / "busy-race").unlink()
            send({"id": request["id"], "error": {
                "message": "thread already has an active or pending turn", "code": -32600}})
            continue
        result = {"turn": {"id": turn_id, "status": "inProgress"}}
        # Deliberately emit completion BEFORE the RPC reply, exercising that race.
        notify("item/completed", {"threadId": thread, "turnId": turn_id,
            "item": {"type": "agentMessage", "id": "answer", "text": "Answer: " + queued[thread]}})
        notify("turn/completed", {"threadId": thread, "turn": {"id": turn_id, "status": "completed"}})
    elif method == "turn/steer":
        result = {"turnId": params["expectedTurnId"]}
    send({"id": request["id"], "result": result})
